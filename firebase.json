{
  "database": {
    "rules": "database.puyo.rules.json"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "functions",
    "predeploy": [
      "npm --prefix functions run build"
    ]
  },
  "hosting": [
    {
      "public": "out",
      "trailingSlash": true,
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "idea/**",
        "**/*.pdf"
      ],
      "cleanUrls": false,
      "headers": [
        {
          "regex": "^/(?:[^a].*|a(?:[^p].*)?|ap(?:[^i].*)?|api(?:[^/].*)?)?$",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/_next/static/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/quizrun/models/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            },
            {
              "key": "Content-Type",
              "value": "model/gltf-binary"
            }
          ]
        },
        {
          "source": "/quizrun/*.mp4",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            },
            {
              "key": "Content-Type",
              "value": "video/mp4"
            }
          ]
        },
        {
          "source": "**/*.mjs",
          "headers": [
            {
              "key": "Content-Type",
              "value": "text/javascript"
            }
          ]
        },
        {
          "source": "/brainstorm/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=604800"
            }
          ]
        }
      ],
      "target": "main",
      "rewrites": [
        {
          "source": "/fish/student",
          "destination": "/fish/index.html"
        },
        {
          "source": "/fish/student/**",
          "destination": "/fish/index.html"
        },
        {
          "source": "/api/jamworld/**",
          "function": {
            "functionId": "jamworldApi",
            "region": "asia-northeast3"
          }
        },
        {
          "source": "/s/**",
          "function": {
            "functionId": "showcase",
            "region": "asia-northeast3"
          }
        },
        {
          "source": "/api/showcase/**",
          "function": {
            "functionId": "showcase",
            "region": "asia-northeast3"
          }
        },
        {
          "source": "/oauth/**",
          "function": {
            "functionId": "mcp",
            "region": "asia-northeast3"
          }
        },
        {
          "source": "/.well-known/openid-configuration{,/**}",
          "function": {
            "functionId": "mcp",
            "region": "asia-northeast3"
          }
        },
        {
          "source": "/.well-known/oauth-authorization-server{,/**}",
          "function": {
            "functionId": "mcp",
            "region": "asia-northeast3"
          }
        },
        {
          "source": "/.well-known/oauth-protected-resource{,/**}",
          "function": {
            "functionId": "mcp",
            "region": "asia-northeast3"
          }
        },
        {
          "source": "/mcp/**",
          "function": {
            "functionId": "mcp",
            "region": "asia-northeast3"
          }
        },
        {
          "source": "/mcp",
          "function": {
            "functionId": "mcp",
            "region": "asia-northeast3"
          }
        }
      ],
      "predeploy": [
        "node scripts/copy-fish.cjs"
      ]
    },
    {
      "target": "idea",
      "public": "out-idea",
      "trailingSlash": true,
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "predeploy": [
        "node scripts/build-idea-site.cjs"
      ],
      "redirects": [
        {
          "source": "/",
          "destination": "/idea/",
          "type": 302
        }
      ],
      "headers": [
        {
          "regex": "^/(?:[^a].*|a(?:[^p].*)?|ap(?:[^i].*)?|api(?:[^/].*)?)?$",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/_next/static/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/brainstorm/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=604800"
            }
          ]
        }
      ]
    },
    {
      "target": "fish",
      "public": "games/fish",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "**/*.@(html|js|json)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=604800"
            }
          ]
        },
        {
          "source": "**/*.glb",
          "headers": [
            {
              "key": "Content-Type",
              "value": "model/gltf-binary"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/student",
          "destination": "/index.html"
        },
        {
          "source": "/student/**",
          "destination": "/index.html"
        }
      ]
    }
  ]
}
