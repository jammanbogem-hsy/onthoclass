rules_version = '2';

// Cloud Storage 보안 규칙
// 제출 첨부(사진/음성): classes/{cid}/lessons/{lid}/questions/{qid}/submissions/{uid}/{file}
// 보드 카드 첨부:        classes/{cid}/canvas/{uid}/{file}
// 피드백/오류 사진:       classes/{cid}/feedback/{uid}/{fid}/{file}
//
// - 읽기: 제출·피드백은 본인 또는 교사 계정만. 보드 첨부만 로그인 사용자 전체.
// - 쓰기: 본인(uid 경로) 폴더에만, 8MB 이하, 안전한 image/audio 형식만(svg 등 제외)
// - 삭제: 본인만
//
// NOTE: Storage 규칙은 Firestore 를 읽을 수 없어 "이 학급의 멤버인가"를 직접
//   확인하지 못한다. 그래서 교사 판정은 ID 토큰의 커스텀 클레임(role)으로 한다
//   (claimTeacherRole 이 부여, 누락분은 syncTeacherClaim 이 보정).
//   제출·피드백은 Firestore 쪽 권한(교사 || 본인)과 이걸로 일치시킬 수 있다.
//   보드 첨부는 같은 학급 학생끼리 서로 봐야 하는데 멤버십을 알 수 없어
//   로그인 전체로 남긴다 — 좁히려면 클레임에 학급 목록을 넣어야 한다.
service firebase.storage {
  match /b/{bucket}/o {

    // 허용 파일 형식(active content 인 svg 등 제외). matches()는 전체 일치이므로
    // 'audio/webm;codecs=opus' 같은 파라미터 접미사를 (;.*)? 로 허용한다.
    function safeMedia() {
      return request.resource.contentType.matches(
        '(image/(png|jpe?g|gif|webp|heic|heif)|audio/(webm|mp4|mpeg|ogg|wav|m4a|aac|x-m4a))(;.*)?'
      );
    }
    // 교사 계정 여부 — Firestore 를 못 읽으므로 커스텀 클레임으로만 판정한다.
    function isTeacherAccount() {
      return request.auth != null && request.auth.token.role == 'teacher';
    }
    function ownerOrTeacher(uid) {
      return request.auth != null
        && (request.auth.uid == uid || isTeacherAccount());
    }
    function safeImage() {
      return request.resource.contentType.matches(
        'image/(png|jpe?g|gif|webp|heic|heif)(;.*)?'
      );
    }

    // 제출 첨부(사진/음성)
    match /classes/{cid}/lessons/{lid}/questions/{qid}/submissions/{uid}/{file} {
      // Firestore 의 제출물 권한(교사 || 본인)과 동일 범위로 맞춘다.
      allow read: if ownerOrTeacher(uid);
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 8 * 1024 * 1024
        && safeMedia();
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // 보드(캔버스) 카드 첨부 — 같은 학급 학생끼리 서로의 카드를 봐야 하는데
    // Storage 에서는 멤버십을 알 수 없어 로그인 전체로 둔다(경로 추측 난이도에 의존).
    match /classes/{cid}/canvas/{uid}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 8 * 1024 * 1024
        && safeMedia();
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // 피드백/오류 신고 사진
    match /classes/{cid}/feedback/{uid}/{fid}/{file} {
      // 오류 신고는 교사 검토용 + 작성 본인만(Firestore feedback 권한과 동일).
      allow read: if ownerOrTeacher(uid);
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 8 * 1024 * 1024
        && safeImage();
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // 그 외 경로는 모두 차단
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
