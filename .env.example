# Firebase 웹앱 설정 (프로젝트: jammanboeng)
# Firebase 콘솔 → 프로젝트 설정 → 일반 → 내 앱 → 웹앱 SDK 구성에서 값 복사
# https://console.firebase.google.com/project/jammanboeng/settings/general

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=jammanboeng.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=jammanboeng
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=jammanboeng.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# 카카오맵 JavaScript SDK 키 (카카오 개발자 콘솔 > 앱 > JavaScript 키, 사이트 도메인 등록 필요)
NEXT_PUBLIC_KAKAO_MAP_KEY=
